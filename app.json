{
  "expo": {
    "name": "recast",
    "slug": "recast",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.hyunw00theo.recast",
      "supportsTablet": false,
      "appleTeamId": "UZTXXV5UD5"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "따라 말한 문장을 녹음해 다시 듣기 위해 마이크가 필요해요."
        }
      ],
      "expo-asset",
      "expo-font",
      "./plugins/withoutPushEntitlement",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "recast"
  }
}
